{
  "name": "careersaathi-server",
  "version": "1.0.0",
  "private": true,
  "description": "CareerSaathi API — career readiness, mentorship and wellbeing platform (SkillNexGen)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed.js --reset",
    "create-admin": "node src/scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 tests/",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.2",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
